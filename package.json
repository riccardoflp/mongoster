{
  "name": "mongoster",
  "displayName": "Mongoster",
  "description": "MongoDB client for VS Code: browse collections in a table, query and aggregate, edit documents, analyze schemas, indexes and relations, monitor the server.",
  "version": "0.5.0",
  "publisher": "RiccardoFilippozzi",
  "author": "Riccardo Filippozzi",
  "repository": "https://github.com/riccardoflp/mongoster",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#10241a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mongodb",
    "mongo",
    "database",
    "nosql",
    "mongosh"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
