    "menus": {
      "view/title": [
        {
          "command": "mongoster.addConnection",
          "when": "view == mongoster.connections",
          "group": "navigation@1"
        },
        {
          "command": "mongoster.refresh",
          "when": "view == mongoster.connections",
          "group": "navigation@2"
        },
        {
          "command": "mongoster.filterTree",
          "when": "view == mongoster.connections && !mongoster.treeFiltered",
          "group": "navigation@1.9"
        },
        {
          "command": "mongoster.clearTreeFilter",
          "when": "view == mongoster.connections && mongoster.treeFiltered",
          "group": "navigation@1.9"
        },
        {
          "command": "mongoster.newPlayground",
          "when": "view == mongoster.connections",
          "group": "navigation@1.5"
        },
        {
          "command": "mongoster.addConnectionWithOptions",
          "when": "view == mongoster.connections",
          "group": "1_add@1"
        },
        {
          "command": "mongoster.showHistory",
          "when": "view == mongoster.connections",
          "group": "navigation@1.7"
        },
        {
          "command": "mongoster.undoLast",
          "when": "view == mongoster.connections",
          "group": "2_history@1"
        },
        {
          "command": "mongoster.showScheduledTasks",
          "when": "view == mongoster.connections",
          "group": "2_history@2"
        },
        {
          "command": "mongoster.importConnections",
          "when": "view == mongoster.connections",
          "group": "3_transfer@1"
        },
        {
          "command": "mongoster.exportConnections",
          "when": "view == mongoster.connections",
          "group": "3_transfer@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mongoster.disconnect",
          "when": "view == mongoster.connections && viewItem =~ /^connection\\.connected/",
          "group": "inline@1"
        },
        {
          "command": "mongoster.refresh",
          "when": "view == mongoster.connections && viewItem =~ /^(connection|database)/",
          "group": "inline@2"
        },
        {
          "command": "mongoster.disconnect",
          "when": "view == mongoster.connections && viewItem =~ /^connection\\.connected/",
          "group": "1_connection@1"
        },
        {
          "command": "mongoster.removeConnection",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "1_connection@2"
        },
        {
          "command": "mongoster.insertDocument",
          "when": "view == mongoster.connections && viewItem =~ /^collection(\\.excluded)?$/",
          "group": "inline@1"
        },
        {
          "command": "mongoster.insertDocument",
