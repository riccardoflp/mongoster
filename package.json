    "configuration": {
      "title": "Mongoster",
      "properties": {
        "mongoster.history.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep an undo history of the changes made from Mongoster to documents (edits, deletes, bulk updates, imports, copies). The documents as they were before are saved compressed in the extension's storage folder, within the limits below. Single connections can be excluded from their context menu.",
          "order": 0
        },
        "mongoster.history.maxSizeMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "markdownDescription": "Disk space of the undo history, in MB: beyond it the oldest operations are deleted.",
          "order": 1
        },
        "mongoster.history.maxDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "markdownDescription": "Days an operation is kept in the undo history.",
          "order": 2
        },
        "mongoster.history.maxOperations": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "Operations kept in the undo history: beyond them the oldest are deleted.",
          "order": 3
        },
        "mongoster.history.maxDocumentsPerOperation": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "markdownDescription": "Operations that change more documents than this aren't recorded (their confirmation says they can't be undone).",
          "order": 4
        },
        "mongoster.history.maxOperationSizeMB": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "markdownDescription": "Operations whose documents take more than this many MB (uncompressed) aren't recorded.",
          "order": 5
        },
        "mongoster.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the MCP server that lets AI assistants (GitHub Copilot, Claude Code, Cursor…) list the connections, read the structure and the documents of the collections, and open queries, aggregations and searches in Mongoster. It listens on `127.0.0.1` only, needs an access token and never writes to a database. Run **Mongoster: Set Up MCP Server for AI Assistants…** to configure a client.",
          "order": 6
        },
        "mongoster.mcp.port": {
          "type": "number",
          "default": 37017,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Port of the MCP server on `127.0.0.1`. AI clients other than GitHub Copilot have it in their configuration: after changing it, copy the configuration again with **Mongoster: Set Up MCP Server for AI Assistants…**. With several VS Code windows open, the port goes to the window you used last, and the tabs the AI opens appear there.",
          "order": 7
        },
        "mongoster.mcp.readDocuments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let the AI read documents (the `find_documents` and `aggregate` tools). Turned off, it only sees connections, databases, collections and their structure, and opens tabs for you to look at the documents.",
          "order": 8
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "mongoster",
        "label": "Mongoster"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.standalone.json",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "build:app": "node esbuild.mjs --app",
    "watch:app": "node esbuild.mjs --app --watch",
    "app": "node esbuild.mjs --app && electron dist/app/main.js",
    "package:app": "node esbuild.mjs --app --production && electron-builder"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "chart.js": "^4.5.1",
    "json5": "^2.2.3",
    "mongodb": "^6.10.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.6.0"
  }
}
