{
  "name": "mongoster",
  "displayName": "Mongoster",
  "description": "MongoDB client for VS Code: browse collections in a table, query and aggregate, edit documents, analyze schemas, indexes and relations, monitor the server.",
  "version": "0.11.0",
  "publisher": "RiccardoFilippozzi",
  "author": "Riccardo Filippozzi",
  "repository": "https://github.com/riccardoflp/mongoster",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#10241a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mongodb",
    "mongo",
    "database",
    "nosql",
    "mongosh"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "colors": [
      {
        "id": "mongoster.color.pink",
        "description": "The pink preset color of connections and collections: their icons in the tree, their tabs and the names of their editor tabs.",
        "defaults": {
          "dark": "#f075b5",
          "light": "#c2185b",
          "highContrast": "#f075b5",
          "highContrastLight": "#c2185b"
        }
      },
      {
        "id": "mongoster.color.teal",
        "description": "The teal preset color of connections and collections: their icons in the tree, their tabs and the names of their editor tabs.",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#00897b",
          "highContrast": "#4ec9b0",
          "highContrastLight": "#00897b"
        }
      },
      {
        "id": "mongoster.color.indigo",
        "description": "The indigo preset color of connections and collections: their icons in the tree, their tabs and the names of their editor tabs.",
        "defaults": {
          "dark": "#8c9eff",
          "light": "#3949ab",
          "highContrast": "#8c9eff",
          "highContrastLight": "#3949ab"
        }
      },
      {
        "id": "mongoster.color.brown",
        "description": "The brown preset color of connections and collections: their icons in the tree, their tabs and the names of their editor tabs.",
        "defaults": {
          "dark": "#c8956b",
          "light": "#8d6e63",
          "highContrast": "#c8956b",
          "highContrastLight": "#8d6e63"
        }
      },
      {
        "id": "mongoster.color.gray",
        "description": "The gray preset color of connections and collections: their icons in the tree, their tabs and the names of their editor tabs.",
        "defaults": {
          "dark": "#a6a6a6",
          "light": "#6e6e6e",
          "highContrast": "#a6a6a6",
          "highContrastLight": "#6e6e6e"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mongoster",
          "title": "Mongoster",
          "icon": "media/mongoster.svg"
        }
      ]
    },
    "views": {
      "mongoster": [
        {
          "id": "mongoster.connections",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mongoster.connections",
        "contents": "No MongoDB connections yet.\n[Add Connection](command:mongoster.addConnection)"
      }
    ],
    "commands": [
