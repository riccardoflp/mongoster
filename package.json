{
  "name": "mongoster",
  "displayName": "Mongoster",
  "description": "Browse MongoDB collections in a table, inspect documents as JSON and build filters by dragging cells.",
  "version": "0.0.1",
  "publisher": "pozzi",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#10241a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mongodb",
    "mongo",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mongoster",
          "title": "Mongoster",
          "icon": "media/mongoster.svg"
        }
      ]
    },
    "views": {
      "mongoster": [
        {
          "id": "mongoster.connections",
          "name": "Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mongoster.connections",
        "contents": "No MongoDB connections yet.\n[Add Connection](command:mongoster.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "mongoster.addConnection",
        "title": "Add Connection",
        "category": "Mongoster",
        "icon": "$(add)"
      },
      {
        "command": "mongoster.removeConnection",
        "title": "Remove Connection",
        "category": "Mongoster",
        "icon": "$(trash)"
      },
      {
        "command": "mongoster.disconnect",
        "title": "Disconnect",
        "category": "Mongoster",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mongoster.refresh",
        "title": "Refresh",
        "category": "Mongoster",
        "icon": "$(refresh)"
      },
      {
        "command": "mongoster.openCollection",
        "title": "Open Collection",
        "category": "Mongoster"
      },
      {
        "command": "mongoster.insertDocument",
        "title": "Insert Document",
        "category": "Mongoster",
        "icon": "$(add)"
      },
      {
        "command": "mongoster.exportCollection",
        "title": "Export Collection…",
        "category": "Mongoster",
        "icon": "$(export)"
      },
      {
        "command": "mongoster.importDocuments",
        "title": "Import Documents…",
        "category": "Mongoster",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mongoster.createDatabase",
        "title": "Create Database…",
        "category": "Mongoster",
        "icon": "$(add)"
      },
      {
        "command": "mongoster.createCollection",
        "title": "Create Collection…",
        "category": "Mongoster",
        "icon": "$(add)"
      },
      {
        "command": "mongoster.renameCollection",
        "title": "Rename Collection…",
        "category": "Mongoster"
      },
      {
        "command": "mongoster.dropCollection",
        "title": "Drop…",
        "category": "Mongoster",
        "icon": "$(trash)"
      },
      {
        "command": "mongoster.dropDatabase",
        "title": "Drop Database…",
        "category": "Mongoster",
        "icon": "$(trash)"
      },
      {
        "command": "mongoster.editConnection",
        "title": "Edit Connection…",
        "category": "Mongoster",
        "icon": "$(edit)"
      },
      {
        "command": "mongoster.copyConnectionString",
        "title": "Copy Connection String",
        "category": "Mongoster"
      },
      {
        "command": "mongoster.setColor",
        "title": "Set Color…",
        "category": "Mongoster",
        "icon": "$(symbol-color)"
      },
      {
        "command": "mongoster.setReadOnly",
        "title": "Make Read-Only",
        "category": "Mongoster",
        "icon": "$(lock)"
      },
      {
        "command": "mongoster.clearReadOnly",
        "title": "Allow Changes",
        "category": "Mongoster",
        "icon": "$(unlock)"
      },
      {
        "command": "mongoster.moveToFolder",
        "title": "Move to Folder…",
        "category": "Mongoster",
        "icon": "$(folder)"
      },
      {
        "command": "mongoster.renameFolder",
        "title": "Rename Folder…",
        "category": "Mongoster"
      },
      {
        "command": "mongoster.removeFolder",
        "title": "Remove Folder (Keep Connections)",
        "category": "Mongoster"
      },
      {
        "command": "mongoster.editValidation",
        "title": "Edit Validation Rules…",
        "category": "Mongoster",
        "icon": "$(checklist)"
      },
      {
        "command": "mongoster.editView",
        "title": "Edit View Definition…",
        "category": "Mongoster",
        "icon": "$(edit)"
      },
      {
        "command": "mongoster.newPlayground",
        "title": "New Playground",
        "category": "Mongoster",
        "icon": "$(file-code)"
      },
      {
        "command": "mongoster.runPlayground",
        "title": "Run Playground",
        "category": "Mongoster",
        "icon": "$(play)"
      },
      {
        "command": "mongoster.changePlaygroundConnection",
        "title": "Change Playground Connection…",
        "category": "Mongoster",
        "icon": "$(database)"
      },
      {
        "command": "mongoster.openMonitor",
        "title": "Open Server Monitor",
        "category": "Mongoster",
        "icon": "$(pulse)"
      },
      {
        "command": "mongoster.copyCollection",
        "title": "Copy Collection To…",
        "category": "Mongoster",
        "icon": "$(copy)"
      },
      {
        "command": "mongoster.watchChanges",
        "title": "Watch Changes",
        "category": "Mongoster",
        "icon": "$(eye)"
      },
      {
        "command": "mongoster.addConnectionWithOptions",
        "title": "Add Connection with TLS / SSH…",
        "category": "Mongoster",
        "icon": "$(plug)"
      },
      {
        "command": "mongoster.connectionOptions",
        "title": "Connection Settings (TLS / SSH)…",
        "category": "Mongoster",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mongoster.addConnection",
          "when": "view == mongoster.connections",
          "group": "navigation@1"
        },
        {
          "command": "mongoster.refresh",
          "when": "view == mongoster.connections",
          "group": "navigation@2"
        },
        {
          "command": "mongoster.newPlayground",
          "when": "view == mongoster.connections",
          "group": "navigation@1.5"
        },
        {
          "command": "mongoster.addConnectionWithOptions",
          "when": "view == mongoster.connections",
          "group": "1_add@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mongoster.disconnect",
          "when": "view == mongoster.connections && viewItem =~ /^connection\\.connected/",
          "group": "inline@1"
        },
        {
          "command": "mongoster.refresh",
          "when": "view == mongoster.connections && viewItem =~ /^(connection|database)/",
          "group": "inline@2"
        },
        {
          "command": "mongoster.disconnect",
          "when": "view == mongoster.connections && viewItem =~ /^connection\\.connected/",
          "group": "1_connection@1"
        },
        {
          "command": "mongoster.removeConnection",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "1_connection@2"
        },
        {
          "command": "mongoster.insertDocument",
          "when": "view == mongoster.connections && viewItem == collection",
          "group": "inline@1"
        },
        {
          "command": "mongoster.insertDocument",
          "when": "view == mongoster.connections && viewItem == collection",
          "group": "1_document@1"
        },
        {
          "command": "mongoster.importDocuments",
          "when": "view == mongoster.connections && viewItem == collection",
          "group": "2_transfer@1"
        },
        {
          "command": "mongoster.exportCollection",
          "when": "view == mongoster.connections && viewItem =~ /^(collection|view)/",
          "group": "2_transfer@2"
        },
        {
          "command": "mongoster.createDatabase",
          "when": "view == mongoster.connections && viewItem =~ /^connection(\\.connected)?$/",
          "group": "0_create@1"
        },
        {
          "command": "mongoster.createCollection",
          "when": "view == mongoster.connections && viewItem == database",
          "group": "inline@1"
        },
        {
          "command": "mongoster.createCollection",
          "when": "view == mongoster.connections && viewItem == database",
          "group": "0_create@1"
        },
        {
          "command": "mongoster.dropDatabase",
          "when": "view == mongoster.connections && viewItem == database",
          "group": "9_drop@1"
        },
        {
          "command": "mongoster.renameCollection",
          "when": "view == mongoster.connections && viewItem == collection",
          "group": "3_manage@1"
        },
        {
          "command": "mongoster.dropCollection",
          "when": "view == mongoster.connections && viewItem =~ /^(collection|view)$/",
          "group": "9_drop@1"
        },
        {
          "command": "mongoster.editConnection",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "1_connection@0"
        },
        {
          "command": "mongoster.copyConnectionString",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "1_connection@3"
        },
        {
          "command": "mongoster.moveToFolder",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "4_organize@1"
        },
        {
          "command": "mongoster.setColor",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "4_organize@2"
        },
        {
          "command": "mongoster.setReadOnly",
          "when": "view == mongoster.connections && viewItem =~ /^connection(\\.connected)?$/",
          "group": "4_organize@3"
        },
        {
          "command": "mongoster.clearReadOnly",
          "when": "view == mongoster.connections && viewItem =~ /^connection.*\\.readonly$/",
          "group": "4_organize@3"
        },
        {
          "command": "mongoster.addConnection",
          "when": "view == mongoster.connections && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "mongoster.addConnection",
          "when": "view == mongoster.connections && viewItem == folder",
          "group": "0_create@1"
        },
        {
          "command": "mongoster.renameFolder",
          "when": "view == mongoster.connections && viewItem == folder",
          "group": "1_folder@1"
        },
        {
          "command": "mongoster.removeFolder",
          "when": "view == mongoster.connections && viewItem == folder",
          "group": "1_folder@2"
        },
        {
          "command": "mongoster.editValidation",
          "when": "view == mongoster.connections && viewItem =~ /^collection/",
          "group": "3_manage@2"
        },
        {
          "command": "mongoster.editView",
          "when": "view == mongoster.connections && viewItem =~ /^view/",
          "group": "3_manage@1"
        },
        {
          "command": "mongoster.newPlayground",
          "when": "view == mongoster.connections && viewItem =~ /^(connection|database|collection|view)/",
          "group": "0_create@9"
        },
        {
          "command": "mongoster.openMonitor",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "2_monitor@1"
        },
        {
          "command": "mongoster.copyCollection",
          "when": "view == mongoster.connections && viewItem =~ /^(collection|view)/",
          "group": "2_transfer@3"
        },
        {
          "command": "mongoster.watchChanges",
          "when": "view == mongoster.connections && viewItem =~ /^(connection|database|collection)/",
          "group": "2_monitor@2"
        },
        {
          "command": "mongoster.connectionOptions",
          "when": "view == mongoster.connections && viewItem =~ /^connection/",
          "group": "1_connection@0.5"
        },
        {
          "command": "mongoster.addConnectionWithOptions",
          "when": "view == mongoster.connections && viewItem == folder",
          "group": "0_create@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mongoster.openCollection",
          "when": "false"
        },
        {
          "command": "mongoster.removeConnection",
          "when": "false"
        },
        {
          "command": "mongoster.disconnect",
          "when": "false"
        },
        {
          "command": "mongoster.insertDocument",
          "when": "false"
        },
        {
          "command": "mongoster.exportCollection",
          "when": "false"
        },
        {
          "command": "mongoster.importDocuments",
          "when": "false"
        },
        {
          "command": "mongoster.createDatabase",
          "when": "false"
        },
        {
          "command": "mongoster.createCollection",
          "when": "false"
        },
        {
          "command": "mongoster.renameCollection",
          "when": "false"
        },
        {
          "command": "mongoster.dropCollection",
          "when": "false"
        },
        {
          "command": "mongoster.dropDatabase",
          "when": "false"
        },
        {
          "command": "mongoster.editConnection",
          "when": "false"
        },
        {
          "command": "mongoster.copyConnectionString",
          "when": "false"
        },
        {
          "command": "mongoster.setColor",
          "when": "false"
        },
        {
          "command": "mongoster.setReadOnly",
          "when": "false"
        },
        {
          "command": "mongoster.clearReadOnly",
          "when": "false"
        },
        {
          "command": "mongoster.moveToFolder",
          "when": "false"
        },
        {
          "command": "mongoster.renameFolder",
          "when": "false"
        },
        {
          "command": "mongoster.removeFolder",
          "when": "false"
        },
        {
          "command": "mongoster.editValidation",
          "when": "false"
        },
        {
          "command": "mongoster.editView",
          "when": "false"
        },
        {
          "command": "mongoster.runPlayground",
          "when": "resourceFilename =~ /\\.mongodb\\.js$/"
        },
        {
          "command": "mongoster.changePlaygroundConnection",
          "when": "resourceFilename =~ /\\.mongodb\\.js$/"
        },
        {
          "command": "mongoster.openMonitor",
          "when": "false"
        },
        {
          "command": "mongoster.copyCollection",
          "when": "false"
        },
        {
          "command": "mongoster.watchChanges",
          "when": "false"
        },
        {
          "command": "mongoster.connectionOptions",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mongoster.runPlayground",
          "when": "resourceFilename =~ /\\.mongodb\\.js$/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mongoster.runPlayground",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceFilename =~ /\\.mongodb\\.js$/"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "json5": "^2.2.3",
    "mongodb": "^6.10.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
